# Токен бота от @MasterBot (обязательно)
BOT_TOKEN=your_token_here

# Способ получения обновлений: polling | webhook (по умолчанию polling)
BOT_MODE=polling

# Уровень логирования: DEBUG | INFO | WARNING | ERROR (по умолчанию INFO)
LOG_LEVEL=INFO

# ID администраторов через запятую (опционально, для служебных команд)
ADMIN_IDS=

# ── Режим webhook ────────────────────────────────────────────────────────────
# Нужны только при BOT_MODE=webhook, в режиме polling игнорируются.

# Публичный HTTPS-адрес бота — его бот регистрирует в MAX (обязательно)
WEBHOOK_URL=https://bot.example.com/max/hook

# Секрет для проверки заголовка X-Max-Bot-Api-Secret.
# Не задан — бот примет запрос от любого, кто знает адрес вебхука.
WEBHOOK_SECRET=

# Интерфейс и порт локального сервера (по умолчанию 0.0.0.0:8080)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Путь, который обслуживает бот. По умолчанию берётся из WEBHOOK_URL —
# задавай явно, только если реверс-прокси срезает префикс пути.
WEBHOOK_PATH=
